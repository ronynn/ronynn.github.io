    <script>
      // DOM Interaction logic

      const getThemeColor = (variable) => {
        return parseInt(
          getComputedStyle(document.documentElement)
            .getPropertyValue(variable)
            .trim()
            .replace("#", "0x"),
        );
      };

      let vantaEffect = VANTA.GLOBE({
        el: "#vanta",
        mouseControls: true,
        touchControls: true,
        gyroControls: true,
        minHeight: 200.0,
        minWidth: 200.0,
        scale: 1.0,
        scaleMobile: 1.0,
        color: getThemeColor("--button"),
        backgroundColor: getThemeColor("--bg"),
        size: 0.8,
      });

      function updateTheme(theme) {
        document.documentElement.setAttribute("data-theme", theme);

        if (vantaEffect) {
          vantaEffect.destroy();
        }

        vantaEffect = VANTA.GLOBE({
          el: "#vanta",
          mouseControls: true,
          touchControls: true,
          gyroControls: true,
          minHeight: 200.0,
          minWidth: 200.0,
          scale: 1.0,
          scaleMobile: 1.0,
          color: getThemeColor("--button"),
          backgroundColor: getThemeColor("--bg"),
          size: 0.8,
        });
      }

      // --- UPDATED DROPDOWN LOGIC ---
      const toggleBtn = document.getElementById("theme-toggle-btn");
      const themeMenu = document.getElementById("theme-menu");

      // Toggle menu visibility on button click
      toggleBtn.addEventListener("click", (e) => {
        e.stopPropagation(); // Prevent bubbling to window
        themeMenu.classList.toggle("show");
      });

      // Handle theme selection
      document
        .querySelectorAll(".theme-dropdown-content button")
        .forEach((btn) => {
          btn.addEventListener("click", () => {
            updateTheme(btn.getAttribute("data-theme"));
            themeMenu.classList.remove("show"); // Close modal after selection
          });
        });

      // Close menu if clicked outside
      window.addEventListener("click", () => {
        if (themeMenu.classList.contains("show")) {
          themeMenu.classList.remove("show");
        }
      });

      // Fetch api requests

      function loadCardData(card) {
        const user = card.getAttribute("data-user");
        const repo = card.getAttribute("data-repo");
        const apiUrl = `https://api.github.com/repos/${user}/${repo}`;

        card.querySelector(".card-name").textContent = repo;
        card.querySelector(".card-link").href =
          `https://github.com/${user}/${repo}`;

        fetch(apiUrl)
          .then((response) => {
            return response.json();
          })
          .then((data) => {
            card.querySelector(".card-description").textContent =
              data.description || "No Description";
          })
          .catch((error) => {
            console.error("Error loading card data:", error);
            card.querySelector(".card-name").textContent = "Error loading data";
          });
      }

      document.querySelectorAll(".card[data-repo]").forEach((card) => {
        loadCardData(card);
      });
    </script>
    
    <script is:inline>      
      // Register Service Worker
  if ('serviceWorker' in navigator) {
    navigator.serviceWorker.register('/sw.js')
      .then(() => console.log('Service Worker Registered'))
      .catch((err) => console.error('Service Worker Registration Failed:', err))
  }
    </script>
